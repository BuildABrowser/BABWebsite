---
import NavBar from "../components/NavBar.astro";

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<slot name="head" /> 
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | BuildABrowser</title>
	</head>
	<body>
		<NavBar/>
		<slot />
	</body>
</html>

<style>
	body {
		color: var(--color-foreground-primary);
		background-color: var(--color-background-primary);
		margin: 0;
		font-family: sans-serif;

		--color-foreground-primary: white;
		--color-background-primary: #0A0A0A;
		--color-background-secondary: #222E;
		--color-foreground-small-code: aquamarine;
		--color-hyperlink: #999;

		--color-accent-1: #005d72;
		--color-accent-2: #2E4057;
		--color-accent-3: #005d72;
		--color-accent-4: #2E4057;
	}

	@media (prefers-color-scheme: light) {
		body {
			--color-foreground-primary: #000;
			--color-background-primary: #F8F8FF;
			--color-background-secondary: #E6E0F6EE;
			--color-foreground-small-code: maroon;
			--color-hyperlink: #666;

			--color-accent-1: #cdb4db;
			--color-accent-2: #ffc8dd;
			--color-accent-3: #ffafcc;
			--color-accent-4: #bde0fe;
		}
	}
	
	:global(a) {
		color: var(--color-hyperlink);
	}

	:global(a) {
		cursor: pointer;
	}

	:global(.astro-code) {
		max-width: fit-content;
		padding: 2em;
	}

	:global(.small-code) {
		font-family: monospace;
		display: inline-block;
		color: var(--color-foreground-small-code, maroon);
	}

	:global(.semicentered) {
		box-sizing: border-box;
		width: min(100%, 120em);
		margin: auto;
	}

	:global(.section) {
		margin: 1em auto;
		padding: 0 2em;
	}

	:global(.section::before) {
		content: '';
		clear: both;
		display: table;
	}

	:global(.nav-button) {
		all: unset;
		position: relative;
		display: inline-block;
		cursor: pointer;
		padding: .75em 1em;
		margin: 1em;
		margin-left: 0;
		color: var(--color-foreground-primary);
	}
	:global(.nav-button:hover) {
		padding: calc(.75em + 1px) calc(1em - 1px) calc(.75em - 1px) calc(1em + 1px);
	}
	/* TODO: Bug: NPE if this contains :hover */
	:global(.nav-button)::after {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		content: '';
	}
	:global(.nav-button:hover)::after {
		background-color: #00000022;
	}
	:global(.ac-1) {
		background-color: var(--color-accent-1);
	}
	:global(.ac-2) {
		background-color: var(--color-accent-2);
	}
	:global(.ac-3) {
		background-color: var(--color-accent-3);
	}
	:global(.ac-4) {
		background-color: var(--color-accent-4);
	}

	:global(:focus-visible) {
		outline: medium solid var(--color-foreground-primary);
	}
</style>
